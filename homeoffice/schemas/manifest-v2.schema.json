{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "homeworld"
    },
    "schemaVersion": {
      "const": 2
    },
    "assetPack": {
      "const": 2
    },
    "createdAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[^\\u0000-\\u001f<>]+$"
    },
    "worldSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "assetPack",
    "createdAt",
    "worldSha256"
  ]
}
